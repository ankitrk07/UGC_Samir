# Runtime mode; mock adapters are rejected in production.
NODE_ENV=development
PORT=4000
# PostgreSQL connection string; use sslmode=require for managed production databases.
DATABASE_URL=postgresql://trendhive:trendhive@127.0.0.1:5432/trendhive
# Redis TCP connection (native/WSL/managed); use rediss:// and credentials in production.
# Queues require a full Redis-compatible TCP server; REST-only URLs are unsupported.
REDIS_URL=redis://localhost:6379
# Replace with random >=32-character signing secret. Rotation revokes existing access tokens.
JWT_SECRET=development-only-replace-with-at-least-32-random-characters
# 32 random bytes encoded as 64 hex characters, AES-256-GCM field encryption.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Exact externally visible frontend/API origins; HTTPS mandatory in production.
SITE_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated exact frontend origins; no wildcard with credentials.
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies. Keep zero without a trusted load balancer.
TRUST_PROXY=0
LOG_LEVEL=info
TERMS_VERSION=2026-11-11
# SMTP blank disables delivery. Configure host, port and sender together to enable.
SMTP_HOST=
SMTP_PORT=
# Credentials are optional; configure both when authentication is required.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional integrations: leave unset, NOT empty, until configured.
# Stripe secret API key and separate webhook signing secret.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Razorpay API key, API secret, and independently configured webhook secret.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Google OAuth web client; callback API_URL/api/v1/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# S3 private bucket and optional S3-compatible endpoint.
S3_REGION=ap-south-1
# S3_BUCKET=
# S3_ENDPOINT=
# Standard AWS SDK credential chain or production IAM task role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Public CDN serving APPROVED keys only; quarantine must remain private.
# CDN_URL=
# Authenticated scanner service receives {assetId,downloadUrl}, returns {clean:boolean}.
# SCANNER_URL=
# SCANNER_SECRET=
# mock for development only; live requires approved social app scopes/tokens.
SOCIAL_MODE=mock
# Optional development-only bio fixture used by MockAdapter verification.
# MOCK_SOCIAL_BIO=
# Optional real conferencing URL included in booking email/calendar.
# MEETING_LINK=
# Development-only seed password. Demo seeding is forbidden in production.
SEED_ADMIN_PASSWORD=TrendHiveDev123!
