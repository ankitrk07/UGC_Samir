NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser requests use the same-origin Next bridge. Include /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional private override (e.g. http://api:4000/api/v1 inside Docker).
API_URL=http://localhost:4000/api/v1
# Exact CDN hostname allowed for managed Next/Image showcase assets.
# NEXT_PUBLIC_MEDIA_HOST=cdn.your-domain.com
